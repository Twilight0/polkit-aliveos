#!/usr/bin/env python3
"""
polkit-aliveos - Lightweight, Transparent PolicyKit Authentication Agent for AliveOS
Key Features:
 - Pure Zenity-GTK3 MessageDialog architecture (100% authentic Zenity look, feel & behavior)
 - Explicit caller disclosure: Displays calling application executable (/proc/<pid>/exe),
   command line, and Polkit Action ID in a clean boxed frame
 - Embedded password reveal toggle inside the Gtk.Entry (connects on both icon-press & icon-release)
 - Cairo translucent overlay for reliable, compositor-independent screen dimming
 - Clean keyboard & mouse handling: Enter to submit, Esc to cancel, responsive OK/Cancel buttons
"""

import json
import os
import signal
import subprocess
import sys
import threading

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GLib', '2.0')
gi.require_version('Polkit', '1.0')
gi.require_version('PolkitAgent', '1.0')

try:
    gi.require_version('GtkLayerShell', '0.1')
    from gi.repository import GtkLayerShell
    HAS_LAYER_SHELL = GtkLayerShell.is_supported()
except Exception:
    HAS_LAYER_SHELL = False

from gi.repository import Gtk, Gdk, GLib, Polkit, PolkitAgent

CONFIG_PATH = os.path.expanduser("~/.config/aliveos/polkit-aliveos.json")

def load_config():
    defaults = {
        "reveal_password": True,
        "screen_dimming": True,
        "play_sound": True,
        "sound_name": "dialog-warning",
        "show_full_command": True,
        "prompt_timeout": 60,
    }
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r") as f:
                defaults.update(json.load(f))
        except Exception:
            pass
    return defaults

def play_alert_sound(sound_name):
    try:
        subprocess.Popen(["canberra-gtk-play", "-i", sound_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def create_dim_overlay():
    """Creates a translucent full-screen backdrop using Cairo drawing."""
    dimmer = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    dimmer.set_title("polkit-aliveos-dimmer")
    dimmer.set_wmclass("polkit-aliveos-dimmer", "polkit-aliveos-dimmer")
    dimmer.set_decorated(False)
    dimmer.set_skip_taskbar_hint(True)
    dimmer.set_skip_pager_hint(True)

    screen = dimmer.get_screen()
    visual = screen.get_rgba_visual()
    if visual:
        dimmer.set_visual(visual)
    dimmer.set_app_paintable(True)

    def on_draw(widget, cr):
        import cairo
        cr.set_operator(cairo.Operator.SOURCE)
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.65)
        cr.paint()
        return False

    dimmer.connect("draw", on_draw)

    if HAS_LAYER_SHELL:
        GtkLayerShell.init_for_window(dimmer)
        GtkLayerShell.set_layer(dimmer, GtkLayerShell.Layer.TOP)
        for edge in (GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT, GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM):
            GtkLayerShell.set_anchor(dimmer, edge, True)
        GtkLayerShell.set_keyboard_mode(dimmer, GtkLayerShell.KeyboardMode.NONE)
    else:
        dimmer.fullscreen()

    return dimmer

class AuthDialog(Gtk.MessageDialog):
    """Native Zenity-GTK3 MessageDialog architecture with explicit caller disclosure."""
    def __init__(self, action_id, message, icon_name, details, users, cfg):
        super().__init__(
            modal=True,
            destroy_with_parent=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=message or "Authentication Required"
        )
        self.set_wmclass("polkit-aliveos", "polkit-aliveos")
        self.set_title("Authentication Required")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_default_response(Gtk.ResponseType.OK)

        self.cfg = cfg
        self.action_id = action_id
        self.users = users
        self.selected_user = users[0] if users else os.getlogin()
        self.dimmer = None

        # Parse caller details
        self.caller_exe = None
        self.caller_cmd = None
        if details:
            try:
                for k in details.get_keys():
                    if k == "program":
                        self.caller_exe = details.lookup("program")
                    elif k == "command_line":
                        self.caller_cmd = details.lookup("command_line")
            except Exception:
                pass

        # Windows UAC-style screen dimming
        if self.cfg.get("screen_dimming", True):
            try:
                self.dimmer = create_dim_overlay()
                self.dimmer.show_all()
            except Exception as e:
                print(f"[!] Dimmer warning: {e}", file=sys.stderr)

        self.build_ui()

        # Keyboard shortcuts: Esc or Backspace to cancel
        self.connect("key-press-event", self.on_key_press)

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_BackSpace):
            if event.keyval == Gdk.KEY_BackSpace and self.entry_pass.has_focus() and len(self.entry_pass.get_text()) > 0:
                return False
            self.response(Gtk.ResponseType.CANCEL)
            return True
        return False

    def build_ui(self):
        self.format_secondary_text("An application is requesting administrative privileges.")

        # Message area where Zenity packs custom inputs
        message_area = self.get_message_area()
        message_area.set_spacing(10)

        # Prominent Executable & Path Box
        if self.cfg.get("show_full_command", True):
            frame = Gtk.Frame()
            frame.set_shadow_type(Gtk.ShadowType.IN)
            frame_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            frame_box.set_border_width(8)

            exe_display = self.caller_exe or self.caller_cmd or "System / Service Daemon"
            lbl_exe = Gtk.Label()
            lbl_exe.set_markup(f"<b>Application:</b> <tt>{GLib.markup_escape_text(exe_display)}</tt>")
            lbl_exe.set_alignment(0.0, 0.5)
            lbl_exe.set_line_wrap(True)
            lbl_exe.set_selectable(True)
            frame_box.pack_start(lbl_exe, False, False, 0)

            lbl_act = Gtk.Label()
            lbl_act.set_markup(f"<b>Action:</b> <small><tt>{GLib.markup_escape_text(self.action_id)}</tt></small>")
            lbl_act.set_alignment(0.0, 0.5)
            lbl_act.set_line_wrap(True)
            lbl_act.set_selectable(True)
            frame_box.pack_start(lbl_act, False, False, 0)

            frame.add(frame_box)
            message_area.pack_start(frame, False, False, 2)

        # User Selection (if multiple identities available)
        if len(self.users) > 1:
            user_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            lbl_user = Gtk.Label(label="Authenticate as:")
            lbl_user.set_alignment(0.0, 0.5)
            user_box.pack_start(lbl_user, False, False, 0)

            combo = Gtk.ComboBoxText()
            for u in self.users:
                combo.append_text(u)
            combo.set_active(0)
            combo.connect("changed", lambda c: setattr(self, "selected_user", c.get_active_text()))
            user_box.pack_start(combo, True, True, 0)
            message_area.pack_start(user_box, False, False, 0)

        # Password Entry Area
        entry_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        
        self.lbl_prompt = Gtk.Label(label=f"Password for {self.selected_user}:")
        self.lbl_prompt.set_alignment(0.0, 0.5)
        entry_vbox.pack_start(self.lbl_prompt, False, False, 0)

        self.entry_pass = Gtk.Entry()
        self.entry_pass.set_visibility(False)
        self.entry_pass.set_activates_default(True)

        # Password Reveal Eye Icon
        if self.cfg.get("reveal_password", True):
            self.entry_pass.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
            self.entry_pass.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, "Click to show / hide password")
            self.entry_pass.set_icon_activatable(Gtk.EntryIconPosition.SECONDARY, True)
            self.entry_pass.connect("icon-press", self.on_reveal_toggle)
            self.entry_pass.connect("icon-release", self.on_reveal_toggle)

        entry_vbox.pack_start(self.entry_pass, False, False, 0)

        # Error notification label
        self.lbl_error = Gtk.Label()
        self.lbl_error.set_markup("<span color='red'></span>")
        self.lbl_error.set_alignment(0.0, 0.5)
        entry_vbox.pack_start(self.lbl_error, False, False, 0)

        message_area.pack_start(entry_vbox, False, False, 4)
        self.show_all()

    def on_reveal_toggle(self, entry, icon_pos, event):
        if icon_pos == Gtk.EntryIconPosition.SECONDARY:
            vis = not entry.get_visibility()
            entry.set_visibility(vis)
            icon = "view-conceal-symbolic" if vis else "view-reveal-symbolic"
            entry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, icon)

    def close_dimmer(self):
        if self.dimmer:
            self.dimmer.destroy()
            self.dimmer = None

    def set_error(self, err_msg):
        self.lbl_error.set_markup(f"<span color='red'><b>{GLib.markup_escape_text(err_msg)}</b></span>")
        self.entry_pass.set_text("")
        self.entry_pass.grab_focus()

class AliveosPolkitListener(PolkitAgent.Listener):
    def __init__(self):
        super().__init__()
        self.cfg = load_config()

    def do_initiate_authentication(self, action_id, message, icon_name, details, cookie, identities, cancellable):
        self.cfg = load_config()
        if self.cfg.get("play_sound", True):
            play_alert_sound(self.cfg.get("sound_name", "dialog-warning"))

        users = []
        for identity in identities:
            if isinstance(identity, Polkit.UnixUser):
                import pwd
                try:
                    name = pwd.getpwuid(identity.get_uid()).pw_name
                    users.append(name)
                except Exception:
                    pass

        GLib.idle_add(self._run_auth_flow, action_id, message, icon_name, details, cookie, identities, cancellable, users)

    def _run_auth_flow(self, action_id, message, icon_name, details, cookie, identities, cancellable, users):
        dialog = AuthDialog(action_id, message, icon_name, details, users, self.cfg)
        
        target_identity = identities[0] if identities else Polkit.UnixUser.new_for_name(dialog.selected_user)
        session = PolkitAgent.Session.new(target_identity, cookie)

        def on_completed(sess, gained_auth):
            if gained_auth:
                dialog.close_dimmer()
                dialog.response(Gtk.ResponseType.OK)
            else:
                dialog.set_error("Authentication failed. Please try again.")

        def on_request(sess, request, echo):
            dialog.lbl_prompt.set_text(request)

        def on_show_error(sess, text):
            dialog.set_error(text)

        session.connect("completed", on_completed)
        session.connect("request", on_request)
        session.connect("show-error", on_show_error)
        session.initiate()

        def on_response(dlg, resp):
            if resp == Gtk.ResponseType.OK:
                pwd_text = dlg.entry_pass.get_text()
                session.response(pwd_text)
            else:
                dlg.close_dimmer()
                session.cancel()
                dlg.destroy()

        dialog.connect("response", on_response)

def run_test_dialog():
    cfg = load_config()
    class DummyDetails:
        def get_keys(self):
            return ["program", "command_line"]
        def lookup(self, key):
            if key == "program":
                return "/usr/bin/pacman"
            elif key == "command_line":
                return "/usr/bin/pacman -Syu --noconfirm"
            return None

    details = DummyDetails()
    dialog = AuthDialog(
        action_id="org.archlinux.pkexec.pacman",
        message="System Update requires administrative privileges",
        icon_name="system-software-update",
        details=details,
        users=[os.getlogin()],
        cfg=cfg
    )
    resp = dialog.run()
    dialog.close_dimmer()
    if resp == Gtk.ResponseType.OK:
        print(f"[✓] Test completed. Entered password: {dialog.entry_pass.get_text()!r}")
    else:
        print("[✗] Test cancelled by user.")
    dialog.destroy()

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--test", "-t", "test"):
        run_test_dialog()
        return

    listener = AliveosPolkitListener()
    subject = Polkit.UnixSession.new_for_process_sync(os.getpid(), None)
    
    try:
        registered = listener.register(
            PolkitAgent.RegisterFlags.NONE,
            subject,
            "/org/aliveos/PolicyKit1/AuthenticationAgent",
            None
        )
        if registered:
            print("[✓] polkit-aliveos authentication agent registered successfully.")
    except Exception as e:
        print(f"[!] Note on listener registration: {e}")

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    Gtk.main()

if __name__ == "__main__":
    main()
